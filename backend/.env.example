NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
ML_SERVICE_URL=http://127.0.0.1:8000

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/biaslens?retryWrites=true&w=majority

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-secret

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
MAIL_FROM=BiasLens <no-reply@example.com>

REDIS_URL=redis://localhost:6379

FEATURE_ENABLE_EMAIL=true
FEATURE_ENABLE_FILE_UPLOADS=true

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
